{
  "$defs": {
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "gate": {
          "minLength": 1,
          "title": "Gate",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "status"
      ],
      "title": "GateResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic hard gates (benchmark spec 6.1). Independent of any model score.",
  "properties": {
    "overall": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ],
      "title": "Overall",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "results",
    "overall"
  ],
  "title": "GateReport",
  "type": "object"
}
