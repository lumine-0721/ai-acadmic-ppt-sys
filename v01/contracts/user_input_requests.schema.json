{
  "$defs": {
    "ProvidedInput": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256",
        "source",
        "license"
      ],
      "title": "ProvidedInput",
      "type": "object"
    },
    "UserInputRequest": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance",
          "type": "array"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^A\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "fallback": {
          "$ref": "#/$defs/UserRequestFallback"
        },
        "format_wanted": {
          "minLength": 1,
          "title": "Format Wanted",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/UserRequestKind"
        },
        "need": {
          "minLength": 1,
          "title": "Need",
          "type": "string"
        },
        "page_ids": {
          "items": {
            "pattern": "^S\\d{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Page Ids",
          "type": "array"
        },
        "provided": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvidedInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_id": {
          "pattern": "^U\\d{3,}$",
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/UserRequestStatus",
          "default": "open"
        },
        "why": {
          "minLength": 1,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "kind",
        "page_ids",
        "need",
        "why",
        "format_wanted",
        "acceptance",
        "blocking",
        "fallback"
      ],
      "title": "UserInputRequest",
      "type": "object"
    },
    "UserRequestFallback": {
      "enum": [
        "placeholder",
        "omit_element",
        "wait"
      ],
      "title": "UserRequestFallback",
      "type": "string"
    },
    "UserRequestKind": {
      "enum": [
        "diagram",
        "chart",
        "statistic",
        "table",
        "icon",
        "image",
        "reference",
        "other"
      ],
      "title": "UserRequestKind",
      "type": "string"
    },
    "UserRequestStatus": {
      "enum": [
        "open",
        "provided",
        "declined",
        "placeholder_rendered"
      ],
      "title": "UserRequestStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "requests": {
      "items": {
        "$ref": "#/$defs/UserInputRequest"
      },
      "title": "Requests",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "UserInputRequests",
  "type": "object"
}
