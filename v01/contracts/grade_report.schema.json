{
  "$defs": {
    "DimScore": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "score": {
          "maximum": 5,
          "minimum": 1,
          "title": "Score",
          "type": "integer"
        }
      },
      "required": [
        "score",
        "reason"
      ],
      "title": "DimScore",
      "type": "object"
    },
    "GradeSummary": {
      "additionalProperties": false,
      "properties": {
        "coherence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coherence"
        },
        "content_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Mean"
        },
        "design_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Design Mean"
        },
        "failing": {
          "items": {
            "enum": [
              "content",
              "design",
              "coherence"
            ],
            "type": "string"
          },
          "title": "Failing",
          "type": "array"
        },
        "not_assessed": {
          "items": {
            "enum": [
              "content",
              "design",
              "coherence"
            ],
            "type": "string"
          },
          "title": "Not Assessed",
          "type": "array"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "rule": {
          "default": "pass iff every assessed dimension >= 3 (content mean, design mean, coherence)",
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        }
      },
      "title": "GradeSummary",
      "type": "object"
    },
    "GraderIdentity": {
      "additionalProperties": false,
      "description": "Who scored. ``agent`` = 宝特 acting by hand: honest label, NOT an API model.",
      "properties": {
        "kind": {
          "enum": [
            "api",
            "agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "vision_model": {
          "default": "",
          "title": "Vision Model",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "GraderIdentity",
      "type": "object"
    },
    "RubricInfo": {
      "additionalProperties": false,
      "description": "Where the rubric comes from (MIT-licensed PPTEval) and how we deviate from it.",
      "properties": {
        "copyright": {
          "minLength": 1,
          "title": "Copyright",
          "type": "string"
        },
        "deviations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Deviations",
          "type": "array"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "name": {
          "const": "PPTEval",
          "default": "PPTEval",
          "title": "Name",
          "type": "string"
        },
        "paper_url": {
          "minLength": 1,
          "title": "Paper Url",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "source_ref",
        "license",
        "copyright",
        "paper_url"
      ],
      "title": "RubricInfo",
      "type": "object"
    },
    "SlideGrade": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_descr": {
          "default": "",
          "title": "Content Descr",
          "type": "string"
        },
        "design": {
          "anyOf": [
            {
              "$ref": "#/$defs/DimScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "design_status": {
          "enum": [
            "scored",
            "not_assessable"
          ],
          "title": "Design Status",
          "type": "string"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "page_id": {
          "anyOf": [
            {
              "pattern": "^S\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        },
        "style_descr": {
          "default": "",
          "title": "Style Descr",
          "type": "string"
        }
      },
      "required": [
        "index",
        "design_status"
      ],
      "title": "SlideGrade",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "PPTEval-style quality grade. Deterministic hard gates are reported separately (gate_report.json).",
  "properties": {
    "background_extracted": {
      "additionalProperties": true,
      "title": "Background Extracted",
      "type": "object"
    },
    "coherence": {
      "anyOf": [
        {
          "$ref": "#/$defs/DimScore"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_level": {
      "enum": [
        "pptx_render",
        "plan_text_proxy"
      ],
      "title": "Evidence Level",
      "type": "string"
    },
    "graded_at": {
      "format": "date-time",
      "title": "Graded At",
      "type": "string"
    },
    "graded_task": {
      "default": "",
      "title": "Graded Task",
      "type": "string"
    },
    "grader": {
      "$ref": "#/$defs/GraderIdentity"
    },
    "rubric": {
      "$ref": "#/$defs/RubricInfo"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/SlideGrade"
      },
      "minItems": 1,
      "title": "Slides",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/GradeSummary"
    }
  },
  "required": [
    "run_id",
    "evidence_level",
    "rubric",
    "grader",
    "graded_at",
    "slides",
    "summary"
  ],
  "title": "GradeReport",
  "type": "object"
}
