{
  "$defs": {
    "RunOverall": {
      "enum": [
        "complete",
        "complete_with_placeholders",
        "needs_input",
        "incomplete",
        "failed"
      ],
      "title": "RunOverall",
      "type": "string"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "input_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "output_files": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Output Files",
          "type": "array"
        },
        "stage": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G",
            "H"
          ],
          "title": "Stage",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "stale_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Reason"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        }
      },
      "required": [
        "stage",
        "name",
        "status"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "done",
        "failed",
        "skipped",
        "not_implemented"
      ],
      "title": "StageStatus",
      "type": "string"
    },
    "UserInputRequestsSummary": {
      "additionalProperties": false,
      "properties": {
        "blocking_open_count": {
          "default": 0,
          "minimum": 0,
          "title": "Blocking Open Count",
          "type": "integer"
        },
        "open_count": {
          "minimum": 0,
          "title": "Open Count",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "placeholder_count": {
          "default": 0,
          "minimum": 0,
          "title": "Placeholder Count",
          "type": "integer"
        },
        "provided_count": {
          "default": 0,
          "minimum": 0,
          "title": "Provided Count",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "open_count"
      ],
      "title": "UserInputRequestsSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code_commit": {
      "default": "unknown",
      "title": "Code Commit",
      "type": "string"
    },
    "code_dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Dirty"
    },
    "defaults_summary": {
      "items": {
        "type": "string"
      },
      "title": "Defaults Summary",
      "type": "array"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "llm_backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Backend"
    },
    "missing_assets": {
      "items": {
        "pattern": "^A\\d{3,}$",
        "type": "string"
      },
      "title": "Missing Assets",
      "type": "array"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "overall": {
      "$ref": "#/$defs/RunOverall"
    },
    "revision_count": {
      "default": 0,
      "minimum": 0,
      "title": "Revision Count",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_utterance": {
      "minLength": 1,
      "title": "Source Utterance",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRecord"
      },
      "title": "Stages",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tool_config": {
      "additionalProperties": true,
      "title": "Tool Config",
      "type": "object"
    },
    "user_input_requests": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserInputRequestsSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "source_utterance",
    "overall",
    "started_at",
    "finished_at",
    "stages"
  ],
  "title": "RunReport",
  "type": "object"
}
