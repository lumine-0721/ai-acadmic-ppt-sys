{
  "$defs": {
    "DesignElement": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "default": "left",
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ],
          "title": "Align",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^A\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "asset_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Path"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "color_hex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Hex"
        },
        "element_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Element Id",
          "type": "string"
        },
        "fill_hex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill Hex"
        },
        "font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font"
        },
        "font_size_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size Pt"
        },
        "h_in": {
          "exclusiveMinimum": 0,
          "title": "H In",
          "type": "number"
        },
        "kind": {
          "$ref": "#/$defs/ElementKind"
        },
        "line_hex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Hex"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^U\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "w_in": {
          "exclusiveMinimum": 0,
          "title": "W In",
          "type": "number"
        },
        "x_in": {
          "title": "X In",
          "type": "number"
        },
        "y_in": {
          "title": "Y In",
          "type": "number"
        },
        "z_index": {
          "default": 0,
          "minimum": 0,
          "title": "Z Index",
          "type": "integer"
        }
      },
      "required": [
        "element_id",
        "kind",
        "x_in",
        "y_in",
        "w_in",
        "h_in"
      ],
      "title": "DesignElement",
      "type": "object"
    },
    "ElementKind": {
      "enum": [
        "title",
        "body",
        "bullet",
        "image",
        "shape",
        "chart",
        "table",
        "placeholder",
        "caption",
        "footer"
      ],
      "title": "ElementKind",
      "type": "string"
    },
    "PageDesignEntry": {
      "additionalProperties": false,
      "properties": {
        "canvas_height_in": {
          "default": 7.5,
          "title": "Canvas Height In",
          "type": "number"
        },
        "canvas_width_in": {
          "default": 13.333,
          "title": "Canvas Width In",
          "type": "number"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/DesignElement"
          },
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        },
        "layout_id": {
          "default": "",
          "title": "Layout Id",
          "type": "string"
        },
        "layout_name": {
          "default": "",
          "title": "Layout Name",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "page_id": {
          "pattern": "^S\\d{3,}$",
          "title": "Page Id",
          "type": "string"
        },
        "preview_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Path"
        }
      },
      "required": [
        "page_id",
        "elements"
      ],
      "title": "PageDesignEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "pages": {
      "items": {
        "$ref": "#/$defs/PageDesignEntry"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "pages"
  ],
  "title": "PageDesign",
  "type": "object"
}
