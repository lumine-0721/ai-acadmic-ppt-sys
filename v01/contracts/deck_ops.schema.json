{
  "$defs": {
    "DeckOp": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^A\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "element_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        },
        "kind": {
          "$ref": "#/$defs/DeckOpKind"
        },
        "op_id": {
          "pattern": "^OP\\d{4}$",
          "title": "Op Id",
          "type": "string"
        },
        "page_id": {
          "pattern": "^S\\d{3,}$",
          "title": "Page Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^U\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "source_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "op_id",
        "page_id",
        "kind"
      ],
      "title": "DeckOp",
      "type": "object"
    },
    "DeckOpKind": {
      "enum": [
        "add_slide",
        "set_placeholder_text",
        "add_textbox",
        "add_shape",
        "add_picture",
        "add_table",
        "add_chart",
        "add_diagram",
        "add_connector",
        "add_placeholder_box",
        "set_notes",
        "set_alt_text",
        "set_name"
      ],
      "title": "DeckOpKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Backend-agnostic deterministic operation list compiled from PageDesign for Office renderers.",
  "properties": {
    "canvas_height_in": {
      "default": 7.5,
      "title": "Canvas Height In",
      "type": "number"
    },
    "canvas_width_in": {
      "default": 13.333,
      "title": "Canvas Width In",
      "type": "number"
    },
    "ops": {
      "items": {
        "$ref": "#/$defs/DeckOp"
      },
      "minItems": 1,
      "title": "Ops",
      "type": "array"
    },
    "page_ids": {
      "items": {
        "pattern": "^S\\d{3,}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Page Ids",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "template_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Path"
    }
  },
  "required": [
    "run_id",
    "page_ids",
    "ops"
  ],
  "title": "DeckOps",
  "type": "object"
}
