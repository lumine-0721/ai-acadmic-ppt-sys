{
  "$defs": {
    "AssetNeed": {
      "additionalProperties": false,
      "description": "What a page needs, in terms stage C can turn into a requirement.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/AssetTarget"
          },
          "title": "Targets",
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/AssetType"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "AssetNeed",
      "type": "object"
    },
    "AssetTarget": {
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "default": "entity",
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "pattern": "^R\\d{3,}$",
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "verification": {
          "$ref": "#/$defs/Verification",
          "default": "to_verify"
        }
      },
      "required": [
        "name"
      ],
      "title": "AssetTarget",
      "type": "object"
    },
    "AssetType": {
      "description": "Asset kinds shared by stage B (asset_needs) and stage C (requirements).",
      "enum": [
        "image",
        "icon",
        "diagram",
        "chart_data",
        "table",
        "reference",
        "statistic"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "PageRole": {
      "description": "Semantic role of a slide declared by Stage B (verified alongside content checks in QA).",
      "enum": [
        "cover",
        "section_divider",
        "quote_statement",
        "content",
        "summary",
        "appendix"
      ],
      "title": "PageRole",
      "type": "string"
    },
    "PointGroup": {
      "additionalProperties": false,
      "description": "Semantic grouping of slide points (e.g. 2 groups -> two-content, 3 groups -> three-card).",
      "properties": {
        "heading": {
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "points": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "heading",
        "points"
      ],
      "title": "PointGroup",
      "type": "object"
    },
    "RevisionEntry": {
      "additionalProperties": false,
      "description": "One edit of the slide plan after real assets came back.",
      "properties": {
        "change": {
          "minLength": 1,
          "title": "Change",
          "type": "string"
        },
        "evidence_asset_ids": {
          "items": {
            "pattern": "^A\\d{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Asset Ids",
          "type": "array"
        },
        "page_ids": {
          "items": {
            "pattern": "^S\\d{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Page Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "change",
        "page_ids",
        "reason",
        "evidence_asset_ids"
      ],
      "title": "RevisionEntry",
      "type": "object"
    },
    "SlidePage": {
      "additionalProperties": false,
      "properties": {
        "asset_needs": {
          "items": {
            "$ref": "#/$defs/AssetNeed"
          },
          "title": "Asset Needs",
          "type": "array"
        },
        "content_summary": {
          "minLength": 1,
          "title": "Content Summary",
          "type": "string"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/PointGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headline"
        },
        "key_points": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Key Points",
          "type": "array"
        },
        "page_id": {
          "pattern": "^S\\d{3,}$",
          "title": "Page Id",
          "type": "string"
        },
        "page_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_refs": {
          "items": {
            "pattern": "^R\\d{3,}$",
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "speaker_notes": {
          "default": "",
          "title": "Speaker Notes",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SlideStatus",
          "default": "provisional"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visual_intent": {
          "minLength": 1,
          "title": "Visual Intent",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "title",
        "goal",
        "key_points",
        "content_summary",
        "visual_intent"
      ],
      "title": "SlidePage",
      "type": "object"
    },
    "SlideStatus": {
      "enum": [
        "provisional",
        "revised"
      ],
      "title": "SlideStatus",
      "type": "string"
    },
    "Verification": {
      "description": "Has this concrete target been checked against a retrieved source?\n\nto_verify (待核实): a candidate that came from model background knowledge only.\nverified  (已核实): backed by at least one retrieved source (source_refs).",
      "enum": [
        "to_verify",
        "verified"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "narrative": {
      "minLength": 1,
      "title": "Narrative",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/SlidePage"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "revision_log": {
      "items": {
        "$ref": "#/$defs/RevisionEntry"
      },
      "title": "Revision Log",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SlideStatus"
    }
  },
  "required": [
    "run_id",
    "status",
    "narrative",
    "pages"
  ],
  "title": "SlidePlan",
  "type": "object"
}
