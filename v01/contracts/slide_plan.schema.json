{
  "$defs": {
    "RevisionEntry": {
      "additionalProperties": false,
      "description": "One edit of the slide plan after real assets came back.",
      "properties": {
        "change": {
          "minLength": 1,
          "title": "Change",
          "type": "string"
        },
        "evidence_asset_ids": {
          "items": {
            "pattern": "^A\\d{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Asset Ids",
          "type": "array"
        },
        "page_ids": {
          "items": {
            "pattern": "^S\\d{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Page Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "change",
        "page_ids",
        "reason",
        "evidence_asset_ids"
      ],
      "title": "RevisionEntry",
      "type": "object"
    },
    "SlidePage": {
      "additionalProperties": false,
      "properties": {
        "asset_needs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Asset Needs",
          "type": "array"
        },
        "content_summary": {
          "minLength": 1,
          "title": "Content Summary",
          "type": "string"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "key_points": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Key Points",
          "type": "array"
        },
        "page_id": {
          "pattern": "^S\\d{3,}$",
          "title": "Page Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SlideStatus",
          "default": "provisional"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visual_intent": {
          "minLength": 1,
          "title": "Visual Intent",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "title",
        "goal",
        "key_points",
        "content_summary",
        "visual_intent"
      ],
      "title": "SlidePage",
      "type": "object"
    },
    "SlideStatus": {
      "enum": [
        "provisional",
        "revised"
      ],
      "title": "SlideStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "narrative": {
      "minLength": 1,
      "title": "Narrative",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/SlidePage"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "revision_log": {
      "items": {
        "$ref": "#/$defs/RevisionEntry"
      },
      "title": "Revision Log",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SlideStatus"
    }
  },
  "required": [
    "run_id",
    "status",
    "narrative",
    "pages"
  ],
  "title": "SlidePlan",
  "type": "object"
}
