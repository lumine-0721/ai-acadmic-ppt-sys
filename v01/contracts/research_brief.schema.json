{
  "$defs": {
    "FilterReason": {
      "enum": [
        "junk_title",
        "too_short",
        "disambiguation",
        "list_page",
        "bad_type",
        "low_relevance"
      ],
      "title": "FilterReason",
      "type": "string"
    },
    "FilteredHit": {
      "additionalProperties": false,
      "description": "A retrieved hit that the relevance filter removed. Kept on record so the removal is auditable.",
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "doc_type": {
          "default": "",
          "title": "Doc Type",
          "type": "string"
        },
        "kind": {
          "enum": [
            "encyclopedia",
            "reference",
            "web"
          ],
          "title": "Kind",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/FilterReason"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_url": {
          "pattern": "^https?://\\S+$",
          "title": "Source Url",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "title",
        "source_url",
        "kind",
        "backend",
        "topic",
        "query",
        "reason"
      ],
      "title": "FilteredHit",
      "type": "object"
    },
    "QueryStatus": {
      "enum": [
        "ok",
        "no_results",
        "error"
      ],
      "title": "QueryStatus",
      "type": "string"
    },
    "RelevanceInfo": {
      "additionalProperties": false,
      "description": "How the filter ran. ``scorer is None`` means structural rules only (and ``note`` says why).",
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "structural",
            "off"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "n_candidates": {
          "minimum": 0,
          "title": "N Candidates",
          "type": "integer"
        },
        "n_filtered": {
          "minimum": 0,
          "title": "N Filtered",
          "type": "integer"
        },
        "n_kept": {
          "minimum": 0,
          "title": "N Kept",
          "type": "integer"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "rules_version": {
          "title": "Rules Version",
          "type": "string"
        },
        "scorer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scorer"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "mode",
        "rules_version",
        "n_candidates",
        "n_kept",
        "n_filtered"
      ],
      "title": "RelevanceInfo",
      "type": "object"
    },
    "ResearchNote": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "doc_type": {
          "default": "",
          "title": "Doc Type",
          "type": "string"
        },
        "kind": {
          "enum": [
            "encyclopedia",
            "reference",
            "web"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license_or_terms": {
          "default": "",
          "title": "License Or Terms",
          "type": "string"
        },
        "note_id": {
          "pattern": "^R\\d{3,}$",
          "title": "Note Id",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "relevance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https?://\\S+$",
          "title": "Source Url",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "kind",
        "title",
        "source_url",
        "source_name",
        "backend",
        "query",
        "retrieved_at"
      ],
      "title": "ResearchNote",
      "type": "object"
    },
    "ResearchQueryRecord": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "hits": {
          "minimum": 0,
          "title": "Hits",
          "type": "integer"
        },
        "lang": {
          "enum": [
            "zh",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QueryStatus"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "topic",
        "query",
        "lang",
        "status",
        "hits",
        "requested_at"
      ],
      "title": "ResearchQueryRecord",
      "type": "object"
    },
    "ResearchStatus": {
      "enum": [
        "ok",
        "partial",
        "no_results",
        "failed",
        "disabled"
      ],
      "title": "ResearchStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Everything stage B retrieved, or the honest record that nothing was.",
  "properties": {
    "filtered": {
      "items": {
        "$ref": "#/$defs/FilteredHit"
      },
      "title": "Filtered",
      "type": "array"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/ResearchNote"
      },
      "title": "Notes",
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/ResearchQueryRecord"
      },
      "title": "Queries",
      "type": "array"
    },
    "relevance_filter": {
      "anyOf": [
        {
          "$ref": "#/$defs/RelevanceInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ResearchStatus"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "provider",
    "status"
  ],
  "title": "ResearchRecord",
  "type": "object"
}
