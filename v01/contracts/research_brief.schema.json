{
  "$defs": {
    "QueryStatus": {
      "enum": [
        "ok",
        "no_results",
        "error"
      ],
      "title": "QueryStatus",
      "type": "string"
    },
    "ResearchNote": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "kind": {
          "enum": [
            "encyclopedia",
            "reference",
            "web"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license_or_terms": {
          "default": "",
          "title": "License Or Terms",
          "type": "string"
        },
        "note_id": {
          "pattern": "^R\\d{3,}$",
          "title": "Note Id",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https?://\\S+$",
          "title": "Source Url",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "kind",
        "title",
        "source_url",
        "source_name",
        "backend",
        "query",
        "retrieved_at"
      ],
      "title": "ResearchNote",
      "type": "object"
    },
    "ResearchQueryRecord": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "hits": {
          "minimum": 0,
          "title": "Hits",
          "type": "integer"
        },
        "lang": {
          "enum": [
            "zh",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QueryStatus"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "topic",
        "query",
        "lang",
        "status",
        "hits",
        "requested_at"
      ],
      "title": "ResearchQueryRecord",
      "type": "object"
    },
    "ResearchStatus": {
      "enum": [
        "ok",
        "partial",
        "no_results",
        "failed",
        "disabled"
      ],
      "title": "ResearchStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Everything stage B retrieved, or the honest record that nothing was.",
  "properties": {
    "notes": {
      "items": {
        "$ref": "#/$defs/ResearchNote"
      },
      "title": "Notes",
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/ResearchQueryRecord"
      },
      "title": "Queries",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ResearchStatus"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "provider",
    "status"
  ],
  "title": "ResearchRecord",
  "type": "object"
}
