{
  "$defs": {
    "AssetRequirement": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance",
          "type": "array"
        },
        "asset_id": {
          "pattern": "^A\\d{3,}$",
          "title": "Asset Id",
          "type": "string"
        },
        "page_ids": {
          "items": {
            "pattern": "^S\\d{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Page Ids",
          "type": "array"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "query_hints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Query Hints",
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/AssetType"
        }
      },
      "required": [
        "asset_id",
        "page_ids",
        "type",
        "purpose",
        "query_hints",
        "priority",
        "acceptance"
      ],
      "title": "AssetRequirement",
      "type": "object"
    },
    "AssetType": {
      "description": "Asset kinds shared by stage B (asset_needs) and stage C (requirements).",
      "enum": [
        "image",
        "icon",
        "diagram",
        "chart_data",
        "table",
        "reference",
        "statistic"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "required",
        "optional"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "items": {
        "$ref": "#/$defs/AssetRequirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "requirements"
  ],
  "title": "AssetRequirements",
  "type": "object"
}
