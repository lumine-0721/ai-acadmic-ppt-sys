{
  "$defs": {
    "AssetRequirement": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance",
          "type": "array"
        },
        "asset_id": {
          "pattern": "^A\\d{3,}$",
          "title": "Asset Id",
          "type": "string"
        },
        "need_refs": {
          "items": {
            "pattern": "^S\\d{3,}#\\d+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Need Refs",
          "type": "array"
        },
        "page_ids": {
          "items": {
            "pattern": "^S\\d{3,}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Page Ids",
          "type": "array"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "query_hints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Query Hints",
          "type": "array"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/AssetTarget"
          },
          "title": "Targets",
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/AssetType"
        }
      },
      "required": [
        "asset_id",
        "page_ids",
        "need_refs",
        "type",
        "purpose",
        "query_hints",
        "priority",
        "acceptance"
      ],
      "title": "AssetRequirement",
      "type": "object"
    },
    "AssetTarget": {
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "default": "entity",
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "pattern": "^R\\d{3,}$",
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "verification": {
          "$ref": "#/$defs/Verification",
          "default": "to_verify"
        }
      },
      "required": [
        "name"
      ],
      "title": "AssetTarget",
      "type": "object"
    },
    "AssetType": {
      "description": "Asset kinds shared by stage B (asset_needs) and stage C (requirements).",
      "enum": [
        "image",
        "icon",
        "diagram",
        "chart_data",
        "table",
        "reference",
        "statistic"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "DroppedNeed": {
      "additionalProperties": false,
      "properties": {
        "need_ref": {
          "pattern": "^S\\d{3,}#\\d+$",
          "title": "Need Ref",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "need_ref",
        "reason"
      ],
      "title": "DroppedNeed",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "required",
        "optional"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Verification": {
      "description": "Has this concrete target been checked against a retrieved source?\n\nto_verify (待核实): a candidate that came from model background knowledge only.\nverified  (已核实): backed by at least one retrieved source (source_refs).",
      "enum": [
        "to_verify",
        "verified"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dropped_needs": {
      "items": {
        "$ref": "#/$defs/DroppedNeed"
      },
      "title": "Dropped Needs",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/AssetRequirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "requirements"
  ],
  "title": "AssetRequirements",
  "type": "object"
}
