{
  "$defs": {
    "DefaultApplied": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "field",
        "value",
        "rationale"
      ],
      "title": "DefaultApplied",
      "type": "object"
    },
    "RetrievalQuery": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "enum": [
            "zh",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "RetrievalQuery",
      "type": "object"
    },
    "RetrievalTopic": {
      "additionalProperties": false,
      "description": "One thing stage B should look up: a neutral question, not a conclusion.",
      "properties": {
        "queries": {
          "items": {
            "$ref": "#/$defs/RetrievalQuery"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Queries",
          "type": "array"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "why": {
          "minLength": 1,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "why",
        "queries"
      ],
      "title": "RetrievalTopic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audience": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Audience",
      "type": "string"
    },
    "constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "content_direction": {
      "minLength": 1,
      "title": "Content Direction",
      "type": "string"
    },
    "defaults_applied": {
      "items": {
        "$ref": "#/$defs/DefaultApplied"
      },
      "title": "Defaults Applied",
      "type": "array"
    },
    "language": {
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "title": "Language",
      "type": "string"
    },
    "open_questions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "purpose": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Purpose",
      "type": "string"
    },
    "retrieval_brief": {
      "items": {
        "$ref": "#/$defs/RetrievalTopic"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Retrieval Brief",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_utterance": {
      "minLength": 1,
      "title": "Source Utterance",
      "type": "string"
    },
    "style": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Style",
      "type": "string"
    },
    "topic": {
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "source_utterance",
    "topic",
    "purpose",
    "audience",
    "language",
    "style",
    "content_direction",
    "retrieval_brief"
  ],
  "title": "ProductionPlan",
  "type": "object"
}
