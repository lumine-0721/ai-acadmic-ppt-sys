{
  "$defs": {
    "AssetChecks": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "quality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "relevance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance"
        },
        "usability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usability"
        }
      },
      "title": "AssetChecks",
      "type": "object"
    },
    "AssetRecord": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^A\\d{3,}$",
          "title": "Asset Id",
          "type": "string"
        },
        "checks": {
          "$ref": "#/$defs/AssetChecks"
        },
        "file_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Path"
        },
        "license_or_terms": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Or Terms"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Name"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "status": {
          "$ref": "#/$defs/AssetStatus"
        }
      },
      "required": [
        "asset_id",
        "status"
      ],
      "title": "AssetRecord",
      "type": "object"
    },
    "AssetStatus": {
      "enum": [
        "acquired",
        "substituted",
        "drawn",
        "missing"
      ],
      "title": "AssetStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetRecord"
      },
      "title": "Assets",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "assets"
  ],
  "title": "AssetRegistry",
  "type": "object"
}
