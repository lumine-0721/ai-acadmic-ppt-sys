{
  "$defs": {
    "MappingEntry": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^A\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "page_id": {
          "pattern": "^S\\d{3,}$",
          "title": "Page Id",
          "type": "string"
        },
        "relevance": {
          "default": "not_assessed",
          "enum": [
            "relevant",
            "weak",
            "irrelevant",
            "not_assessed"
          ],
          "title": "Relevance",
          "type": "string"
        },
        "relevance_note": {
          "default": "",
          "title": "Relevance Note",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^U\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "usage": {
          "minLength": 1,
          "title": "Usage",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "usage",
        "accepted"
      ],
      "title": "MappingEntry",
      "type": "object"
    },
    "UnusedAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^A\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^U\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        }
      },
      "required": [
        "reason"
      ],
      "title": "UnusedAsset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "mappings": {
      "items": {
        "$ref": "#/$defs/MappingEntry"
      },
      "title": "Mappings",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "unused_assets": {
      "items": {
        "$ref": "#/$defs/UnusedAsset"
      },
      "title": "Unused Assets",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "mappings"
  ],
  "title": "SlideAssetMapping",
  "type": "object"
}
